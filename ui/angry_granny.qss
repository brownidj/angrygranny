/* angry_granny.qss — shared styles for both UIs */

/* === GENERAL APP LOOK === */
QMainWindow, QWidget {
    background-color: #F5F5F5;
    color: #222;
    font-family: "Avenir Next", "Helvetica Neue", Arial, sans-serif;
    font-size: 16px;
}

/* === HEADERS / TITLES === */
QLabel#titleLabel, QLabel[class~="header"] {
    font-size: 24px;
    font-weight: bold;
    color: #2E3A59;
}

/* === BUTTONS === */
QPushButton {
    background-color: #6270BB;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
}

QPushButton:hover {
    background-color: #4F5DA6;
}

QPushButton:pressed {
    background-color: #3E4C93;
}

/* Special-purpose buttons (if you use them later) */
QPushButton#btnExit {
    background-color: #C0392B;
}

QPushButton#btnContinue {
    background-color: #27AE60;
}

/* === TABS === */
QTabWidget::pane {
    border: 1px solid #CCC;
    border-radius: 8px;
    background-color: white;
}

QTabBar::tab {
    background-color: #E0E0E0;
    border: 1px solid #CCC;
    border-bottom-color: #BBB;
    padding: 8px 14px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-width: 100px;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    border-bottom-color: #FFF;
    color: #2E3A59;
}

/* === LISTS (for players list in portrait mode) === */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #CCC;
    border-radius: 8px;
    padding: 4px;
}

QListWidget::item {
    padding: 10px;
}

QListWidget::item:selected {
    background-color: #6270BB;
    color: white;
}

/* === INPUT FIELDS === */
QLineEdit, QComboBox, QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #CCC;
    border-radius: 4px;
    padding: 6px;
}

/* === TOOLBARS / STATUSBARS === */
QToolBar {
    background-color: #E8EAF6;
    border-bottom: 1px solid #BBB;
}

QStatusBar {
    background-color: #E8EAF6;
    border-top: 1px solid #BBB;
}

/* === SCROLLBARS (touch-friendly) === */
QScrollBar:vertical, QScrollBar:horizontal {
    background: #E0E0E0;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #A0A0A0;
    border-radius: 6px;
}

QScrollBar::handle:hover {
    background: #888;
}